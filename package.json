{
  "name": "otel-demo",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/schema",
    "extractor",
    "content",
    "atlas"
  ],
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "extract": "npm run extract -w @otel-demo/extractor",
    "validate:data": "npm run validate:data -w @otel-demo/extractor",
    "build": "npm run build -w @otel-demo/atlas",
    "dev": "npm run dev -w @otel-demo/atlas"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
